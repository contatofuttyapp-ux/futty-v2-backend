# Copia este ficheiro para .env e preenche com as tuas chaves do Supabase
# (Supabase Dashboard -> Project Settings -> API)

SUPABASE_URL=https://ynzmjcvqdljffgbeqglh.supabase.co
# ── Chaves no formato NOVO do Supabase (Rodada 28) ─────────────────────────
# Painel → Project Settings → API Keys. As novas giram sem derrubar as sessões
# e podem ser revogadas uma a uma. O motor usa a secreta; os testes e scripts
# usam a publishable para abrir sessão de teste. Nunca imprimir nem commitar.
# A chave SECRETA (sb_secret_…): só no servidor (este .env e o Cloud Run),
# nunca no app. Ignora RLS — é a chave do motor.
SUPABASE_SECRET_KEY=sb_secret_cole_aqui
# A chave PUBLISHABLE (sb_publishable_…): a mesma que o app usa; sujeita a RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_cole_aqui
# ── Chaves ANTIGAS (JWT) — reserva enquanto as novas não estiverem aqui ──────
# Só são lidas se a nova correspondente faltar (utils/chavesSupabase.js).
# Depois de desligar as antigas no painel, apagar estas duas linhas.
SUPABASE_ANON_KEY=a_tua_anon_public_key
SUPABASE_SERVICE_KEY=a_tua_service_role_key
PORT=3001
# Segredo de assinatura do proxy de imagem (utils/mediaToken.js) — 32 bytes
# aleatórios, só teu, nunca reaproveitar outra chave. Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ou: openssl rand -hex 32
# Obrigatório em produção (NODE_ENV=production) — o servidor recusa arrancar
# sem ele. Define também no Render (Environment).
MEDIA_TOKEN_SECRET=gera_32_bytes_aleatorios_e_cola_aqui
# Sentry (error tracking) — DSN do projecto "futty-backend" (sentry.io)
SENTRY_DSN=https://exemplo@o000000.ingest.sentry.io/0000000


# ── A FIGURINHA EM DUAS PASSADAS (22-set) ──────────────────────────────────
# A receita vive em utils/geracaoFigurinha.js; estas variáveis existem para
# trocar motor ou qualidade sem deploy. Mexer aqui muda o que sai na figurinha
# E o que se paga — só com uma bancada a dizer que vale a pena.
#
# Passada 1 (a CARA): custa ~US$0,025 e é a que o dono aprovou pela semelhança.
FAL_PASSADA1_ENDPOINT=openai/gpt-image-2.5/flare/edit
# Passada 2 (o ACABAMENTO): repinta no estilo da casa, ~US$0,020.
FAL_PASSADA2_ENDPOINT=fal-ai/gpt-image-1.5/edit
# O recorte de fundo, antes e depois da passada 2 (~US$0,002 cada).
FAL_BIREFNET_ENDPOINT=fal-ai/birefnet
# Qualidade das duas passadas. Lei da casa: uma só, low, para todos os planos.
FAL_QUALITY=low
# Fidelidade da imagem de entrada da PASSADA 2. BAIXA é a receita aprovada e é
# onde está a economia: 135 tokens de imagem em vez de 3.050. Alta aqui
# devolveria o custo da V6 (US$0,112) sem melhorar nada — a imagem que entra
# na passada 2 já é a resposta certa, não há o que "ler com atenção".
FAL_INPUT_FIDELITY_PASSADA2=low
